__pycache__/
*.pyc
.venv/
venv/
.git/
.gitignore

# Secrets and private data
private/
.env
*.env
cookies.json
www.youtube.com_cookies.json
www.youtube.com_cookies.txt
*cookies*.json
*cookies*.txt
*.example
screenshots/

# Local tools, docs, tests and tooling
autopilot.py
startbrowser.py
tempCodeRunnerFile.py
*.md
tests/
test_*.py
pytest.ini
.pytest_cache/
contracts/
.error_contract/
.github_contract/
