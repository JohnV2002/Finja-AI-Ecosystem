# Project: Finja - Twitch Interactivity Suite
# Module: finja-chat / .env.example
# Author: J. Apps (JohnV2002 / Sodakiller1)
# Version: 2.5.0
# Description: Safe Spotify song-request environment template.
# New in v2.5.0: Docker settings for the compose file (FINJA_CHAT_*), next to the Spotify keys.
# Earlier in v2.4.1: Module version aligned; no Twitch secret is persisted.
# Copyright (c) 2026 J. Apps — Licensed under the MIT License.

SPOTIPY_CLIENT_ID=Deine_id
SPOTIPY_CLIENT_SECRET=Dein_secret
SPOTIPY_REDIRECT_URI=https://127.0.0.1:8080/callback
SR_COOLDOWN_SECS=120
SR_FORCE_NOW=false
SR_MAX_PENDING_PER_USER=1
SR_MODERATED=false
SR_MIN_POPULARITY=15

# --- Docker (docker-compose.yml reads these from the .env next to it) ---
# Digest-pinned base image, e.g. python:3.14-slim@sha256:...
FINJA_CHAT_PYTHON_BASE_IMAGE=
# Where the three ports listen: loopback by default; the host's private LAN address to reach it from OBS.
FINJA_CHAT_BIND=127.0.0.1
# Origins the song server answers (overlay/panel address), comma-separated.
FINJA_CHAT_ALLOWED_ORIGINS=http://127.0.0.1:8088
# Analytics Contract (off by default): errors, CPU and RAM to the Analytics Collector.
FINJA_CHAT_ANALYTICS_ENABLED=false
FINJA_CHAT_ANALYTICS_ENDPOINT=http://analytics-collector:8080
FINJA_CHAT_ANALYTICS_TOKEN=
# Owner-only diagnostics probe (empty = probe off).
FINJA_CHAT_PROBE_TOKEN=
