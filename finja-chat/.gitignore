# Secrets — NEVER commit!
.env

# Local-only files synced manually from the production workspace. They never
# belong in the public repository.
private/
TODO.md

# Contract preflight state is machine-local and regenerated on demand.
.error_contract/
.github_contract/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Test coverage artifacts (regenerated by `pytest --cov`, never commit)
.coverage
coverage.xml
htmlcov/
