{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jappshome.de/schemas/analytics-contract/contract-1.0.json",
  "title": "Analytics Contract Project Configuration 1.0",
  "type": "object",
  "required": ["schema_version", "protocol", "project", "analytics", "error_integration", "privacy", "metrics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_schema", "api_major"],
      "properties": {
        "event_schema": { "const": "1.0" },
        "api_major": { "const": 1 }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "languages", "runtimes"],
      "properties": {
        "id": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "runtimes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "analytics": {
      "type": "object",
      "required": ["enabled", "endpoint_env", "timeout_ms", "fail_silent", "queue"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "endpoint": { "type": ["string", "null"], "default": null },
        "endpoint_env": { "type": "string", "default": "ANALYTICS_ENDPOINT" },
        "auth_token_env": { "type": "string", "default": "ANALYTICS_TOKEN" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "fail_silent": { "const": true },
        "queue": { "type": "object" }
      }
    },
    "error_integration": {
      "type": "object",
      "required": ["mode", "reuse_error_event", "file_path_mode", "include_source", "include_stacktrace"],
      "properties": {
        "mode": { "enum": ["error_contract", "none"] },
        "reuse_error_event": { "const": true },
        "file_path_mode": { "const": "project_relative" },
        "include_source": { "const": false },
        "include_stacktrace": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["allow_secrets", "allow_prompts", "allow_absolute_paths", "allowed_tags"],
      "properties": {
        "allow_secrets": { "const": false },
        "allow_prompts": { "type": "boolean", "default": false },
        "allow_absolute_paths": { "const": false },
        "allowed_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["environment", "version", "component", "operation", "outcome"] }
        }
      }
    },
    "metrics": { "type": "object" }
  }
}

