# ======================================================================
#          Finja Canvas – Environment Variables
# ======================================================================
#
#   Project: Finja - Twitch Interactivity Suite
#   Module:  finja-canvas
#   Author:  J. Apps (JohnV2002 / Sodakiller1)
#   Version: 1.2.0
#
#   Changes (1.2.0): Painter switch, port bind address, analytics and probe settings.
#
# ----------------------------------------------------------------------
#
#   Copy this file to .env and adjust the settings below.
#   Recraft V4.1 Vector is the default motif artist and costs $0.08 per motif.
#
# ======================================================================

OPENROUTER_API_KEY=openrouter-key-with-recraft-credit!

# --- Painter switch -------------------------------------------------------
# false = only the canvas page runs (no key needed, no Recraft credit used).
CANVAS_PAINTER_ENABLED=true

# --- Docker ---------------------------------------------------------------
# Where port 7676 listens: loopback by default; the host's private LAN address to reach it from OBS.
CANVAS_BIND=127.0.0.1

# --- Analytics Contract (off by default) ----------------------------------
# Errors, CPU and RAM to the Analytics Collector, which hands repeated errors to Flare.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=http://analytics-collector:8080
ANALYTICS_TOKEN=

# --- Owner-only diagnostics probe (empty = probe off) ---------------------
CANVAS_PROBE_TOKEN=
