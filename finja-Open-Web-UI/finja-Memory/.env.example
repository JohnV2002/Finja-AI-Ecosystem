# Project: Finja - Twitch Interactivity Suite
# Module: finja-cloud-memory / .env.example
# Author: J. Apps (JohnV2002 / Sodakiller1)
# Version: 4.5.1
# Description: Settings template. Copy to private/.env (private/ is never committed).
# New in 4.5.0: private/.env instead of a .env in the repository; analytics, probe and
#   dashboard settings.
# Copyright (c) 2026 J. Apps - Licensed under the Apache License 2.0.

MEMORY_API_KEY=your-super-secret-api-key-here
# A key of its own for the memory files (do not share it with other services).
# New random key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FINJA_DATA_ENCRYPTION_KEY=your_key

# Optional: Finja dashboard metrics (empty = off)
FINJA_DASHBOARD_URL=

# Analytics Contract (off by default): errors, CPU and RAM to the Analytics Collector,
# which hands repeated errors to Flare. Off = no thread, no network traffic.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=http://analytics-collector:8080
ANALYTICS_TOKEN=

# Owner-only diagnostics probe (empty = probe off)
MEMORY_PROBE_TOKEN=
