# ======================================================================
#          Finja Research Orchestrator - Dockerfile
# ======================================================================
#
#   Project: Finja Web Crawler
#   Module: finja-research-orchestrator
#   Author: J. Apps (JohnV2002 / Sodakiller1)
#   Version: 2.2.0
#
#   New in v2.2.0: ships the shared error reporting (core/, crawler_reporting.py,
#   analytics_sender.py, analytics_contract.json).
#
# ----------------------------------------------------------------------
#
#   Mother Docker for search/crawl/research orchestration.
#   The actual untrusted page-read worker is a separate future service.
#
# ======================================================================

FROM python:3.15-alpine AS builder
WORKDIR /app

RUN apk add --no-cache gcc linux-headers musl-dev

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.15-alpine
WORKDIR /app

RUN addgroup -S appgroup && \
    adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /app

# Version-agnostic: no hard-coded python3.XX/site-packages
COPY --from=builder /install /usr/local

COPY research_orchestrator.py crawler_stats.py ./
COPY crawler_reporting.py analytics_sender.py analytics_contract.json ./
COPY core ./core

USER appuser

EXPOSE 80
CMD ["uvicorn", "research_orchestrator:app", "--host", "0.0.0.0", "--port", "80"]
