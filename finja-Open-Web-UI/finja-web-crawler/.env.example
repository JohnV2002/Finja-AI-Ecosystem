# ======================================================================
#          Finja Web Crawler – Environment Variables
# ======================================================================
#
#   Project: Finja - Twitch Interactivity Suite
#   Module:  finja-web-crawler
#   Author:  J. Apps (JohnV2002 / Sodakiller1)
#   Version: 2.2.0
#   New in v2.2.0: copy to private/.env (private/ is never committed);
#   analytics and probe settings.
#
# ----------------------------------------------------------------------
#
#   mkdir -p private && cp .env.example private/.env  -- then fill in.
#   Generate a secure 64-character token with:  python generate_token.py
#
# ======================================================================

# Shared bearer token used to authenticate calls to the crawler API.
BEARER_TOKEN=your-64-character-token-here

# Analytics Contract (off by default): errors, CPU and RAM to the Analytics Collector,
# which hands repeated errors to Flare. Off = no thread, no network traffic.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=http://analytics-collector:8080
ANALYTICS_TOKEN=

# Owner-only diagnostics probe on the research orchestrator (empty = probe off)
CRAWLER_PROBE_TOKEN=
