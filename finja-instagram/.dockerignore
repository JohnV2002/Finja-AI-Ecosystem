__pycache__/
*.pyc
*.pyo
.venv/
venv/
.git/
.gitignore
screenshots/
*.md

# Local launcher and prototype (not needed in container)
autopilot.py
startbrowser.py

# Sensitive files — never include in Docker image!
private/
www.instagram.com_cookies.json
www.instagram.com_cookies.txt
*.example
.env

# Tests and contract tooling (not needed in the container)
tests/
test_*.py
pytest.ini
.pytest_cache/
contracts/
.error_contract/
.github_contract/
