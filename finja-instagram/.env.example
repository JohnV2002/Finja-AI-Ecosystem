# ======================================================================
#          Finja Instagram Reels – Environment Variables
# ======================================================================
#
#   Project: Finja - Twitch Interactivity Suite
#   Module:  finja-instagram
#   Author:  J. Apps (JohnV2002 / Sodakiller1)
#   Version: 1.2.0
#   New in v1.2.0: Analytics, VPN bypass subnet and probe settings.
#   Copyright (c) 2026 J. Apps - Licensed under the MIT License.
#
#   Copy this file as .env and fill in your values:
#     cp .env.example .env
#
#   ProtonVPN OpenVPN credentials can be found at:
#   https://account.protonvpn.com/account#openvpn
#
#   WARNING: These are NOT your normal ProtonVPN login credentials!
#            Look for "OpenVPN / IKEv2 username" on the page.
#
# ======================================================================

# ProtonVPN OpenVPN Credentials
PROTON_USER=
PROTON_PASS=

# VPN Server Country (default: Germany) -- deliberately a DIFFERENT
# country than finja-youtube's VPN_COUNTRY, for IP diversity between
# the two services.
# Options: Netherlands, Germany, Switzerland, Sweden, etc.
VPN_COUNTRY_IG=Germany

# ==========================================
# Application Configuration
# ==========================================

# ---- Instagram Config ----
# Starts on about:blank and only navigates when /wakeup is called
INSTAGRAM_TARGET_URL=about:blank

# ---- Chrome Settings ----
CHROME_PORT=9222

# ---- Finja Brain & Discord (for Autopilot) ----
FINJA_BRAIN_URL=http://localhost:8051
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==========================================
# Analytics Contract & Flare (v1.2.0, off by default)
# ==========================================
# Errors, CPU and RAM to the Analytics Collector, which hands repeated errors to Flare.
INSTAGRAM_ANALYTICS_ENABLED=false
# An IP address on the analytics-ingest network (DNS goes through the VPN, names do not resolve).
INSTAGRAM_ANALYTICS_ENDPOINT=http://<collector-ip-on-analytics-ingest>:8080
INSTAGRAM_ANALYTICS_TOKEN=
# The analytics-ingest subnet Gluetun lets past the tunnel (empty = nothing bypasses the VPN).
INSTAGRAM_ANALYTICS_SUBNET=
# Owner-only diagnostics probe (empty = probe off).
INSTAGRAM_PROBE_TOKEN=
