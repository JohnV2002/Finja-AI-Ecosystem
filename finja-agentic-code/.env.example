# Flare (Finja Agentic Code) / environment template - Version: 1.11.0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.7-code
# Host interface for the normal Compose service. Keep loopback unless a
# protected reverse proxy or private network requires an explicit binding.
FLARE_BIND_HOST=127.0.0.1
AGENT_JOBS_HOST_DIR=<repo-path>/finja-agentic-code/agent_jobs
WORKER_IMAGE=finja-agent-worker:dev
WORKER_NETWORK=none
# L3 executes submitted tests; any other worker network is refused.
MAX_PARALLEL_JOBS=2
# Maximum non-terminal quests, including those awaiting approval.
MAX_ACTIVE_JOBS=5
# Concurrent execution slots for one logical repository.
MAX_PARALLEL_JOBS_PER_REPOSITORY=1
# Active execution emits durable liveness/progress signals at this interval.
HEARTBEAT_INTERVAL_SECONDS=5
# Health reports an executing job as stale after this many silent seconds.
HEARTBEAT_STALE_SECONDS=30
# Keep only the newest reports in each durable job status document.
PROGRESS_REPORT_LIMIT=50
JOB_TIMEOUT_SECONDS=600
JOB_TOTAL_TIMEOUT_SECONDS=900
# Hotfix mode requires this many fresh, matching green sandbox runs (2-7).
L4_REQUIRED_GREEN_RUNS=3
# Delay Finja should observe before requesting one new attempt after a safe timeout rollback.
FINJA_TIMEOUT_RETRY_AFTER_SECONDS=30
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
# Identical keyless submissions reuse active/recent successful jobs for this long.
# Set to 0 to disable content-based dedupe; Idempotency-Key remains durable.
DEDUPE_WINDOW_SECONDS=300
# Shared bearer token between Finja and the orchestrator. Generate with:
#   python -c "import secrets; print('flare-'+secrets.token_urlsafe(32))"
# The SAME value must later go into Finja's .env. Empty = auth disabled (dev only).
ORCHESTRATOR_AUTH_TOKEN=
# Optional AES-GCM transport key shared with Finja. Keep the real value private.
CODE_AGENT_TRANSPORT_KEY=
# Optional source file used by tools_configure_vm.sh to import OPENROUTER_API_KEY.
FINJA_ENV_FILE=<repo-path>/finja-agentic-code/private/finja.env
# Comma separated HOST folders (for example the main Finja container's data) that no
# worker mount may sit in. AGENT_JOBS_HOST_DIR inside one of them is refused (FLARE-502).
FLARE_PROTECTED_HOST_PATHS=
# Quest supervisor (see the README): reminders and withdrawal of unanswered approvals.
# SUPERVISOR=1
# SUPERVISOR_INTERVAL_SECONDS=60
# SUPERVISOR_APPROVAL_REMIND_SECONDS=86400
# SUPERVISOR_APPROVAL_EXPIRE_SECONDS=259200
# SUPERVISOR_APPROVAL_NOTICE_SECONDS=3600
