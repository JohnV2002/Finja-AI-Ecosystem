# Project: Finja - Twitch Interactivity Suite
# Module: finja-everything-in-once / .env.example
# Author: J. Apps (JohnV2002 / Sodakiller1)
# Version: 1.3.0
# Description: Optional settings for the web server; copy to .env next to webserver.py.
# New in 1.3.0: First version: Analytics Contract and diagnostics probe settings.
# Copyright (c) 2026 J. Apps - Licensed under the MIT License.

# Spotify enrichment (optional; config/config_spotify.json covers the now-playing poller)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Analytics Contract (off by default): errors to the Analytics Collector, which hands
# repeated errors to Flare. Off = no thread, no network traffic.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=http://<collector-host>:8081
ANALYTICS_TOKEN=

# Owner-only diagnostics probe (empty = probe off)
MUSIC_PROBE_TOKEN=
