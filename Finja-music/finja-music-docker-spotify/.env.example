# Project: Finja - Twitch Interactivity Suite | Module: finja-music-docker-spotify | Version: 1.3.0 | Copyright (c) 2026 J. Apps - MIT License
# Finja Music Docker Spotify API - environment example.
# Copy to private/.env and fill in your real values (private/ is never
# synced or committed).
#
# NOTE: These are the exact variable names app.py reads via os.getenv() --
# a placeholder .env shipped on GitHub previously used CLIENT_ID/CLIENT_SECRET
# (no SPOTIFY_ prefix, no refresh token), which would silently do nothing
# since app.py never reads those names.

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token
# Spotify ends refresh tokens 6 months after the login: renew with `python spotify_reauth.py`.

# Analytics Contract (v1.3.0, off by default): errors, CPU and RAM to the Analytics Collector,
# which hands repeated errors to Flare. Off = no thread, no network traffic.
ANALYTICS_ENABLED=false
ANALYTICS_ENDPOINT=http://analytics-collector:8080
ANALYTICS_TOKEN=

# Owner-only diagnostics probe (empty = probe off).
MUSIC_DOCKER_PROBE_TOKEN=
